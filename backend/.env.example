# Copy to backend/.env (git-ignored) and fill in. Server-side only: the
# secret key must never reach the browser or the frontend's env files.

PORT=5000

# Supabase: Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-service-role-key

# Component 1: article ingestion (optional)
NEWS_API_KEY=your-newsapi-org-key
RELIEFWEB_APPNAME=your-approved-reliefweb-appname
INGESTION_API_KEY=long-random-string-shared-with-frontend

# Component 3: warehouse
SPATIAL_SERVICE_URL=http://localhost:8000
WAREHOUSE_TIME_ZONE=Asia/Colombo

# Component 4: pharmacy
PHARMACY_TIME_ZONE=Asia/Colombo
# Days of sales history loaded for charts and the actual-vs-estimated comparison
# (the moving-average window itself is a pharmacy setting).
PHARMACY_HISTORY_DAYS=180
# Recalculate recommendations and alerts for all pharmacies every N hours
# (empty or 0 = only when staff click "Recalculate recommendations").
PHARMACY_FORECAST_INTERVAL_HOURS=
